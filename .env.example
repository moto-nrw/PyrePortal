# Local browser development
VITE_API_BASE_URL=http://localhost:8080
VITE_DEVICE_API_KEY=your_device_api_key_here

# Comma-separated RFID tags that exist in the connected backend.
# The browser mock chooses from this list while scanning is active.
VITE_MOCK_RFID_TAGS=04:D6:94:82:97:6A:80

# GKT and Wedge builds receive their API URL at build time. Kiosk device keys
# come from the ?key=... URL parameter and must never be committed.
